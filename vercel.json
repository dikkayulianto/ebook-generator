{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "redirects": [
    {
      "source": "/game_petualangan_islami:ext(.html)?",
      "destination": "/game-petualangan-islami.html",
      "permanent": true
    },
    {
      "source": "/modul_ajar_deep_learning_kelas1_bab1:ext(.html)?",
      "destination": "/modul-ajar-pai-kelas-1.html",
      "permanent": true
    },
    {
      "source": "/soal_sas_prototype:ext(.html)?",
      "destination": "/soal-sas-pai-kelas-1.html",
      "permanent": true
    },
    {
      "source": "/buku_siswa_pai_kelas1_semester1:ext(.html)?",
      "destination": "/buku-siswa-pai-kelas-1.html",
      "permanent": true
    }
  ]
}
