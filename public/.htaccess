# ====================================================================
# .htaccess untuk Portal Bahan Ajar Bu Guru
# Kompatibel dengan Apache & LiteSpeed Web Server (cPanel / DirectAdmin)
# ====================================================================

# 1. Pastikan Charset UTF-8 default
AddDefaultCharset UTF-8

# 2. Aktifkan Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Paksa Penggunaan HTTPS (SSL Aman)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Hilangkan ekstensi .html dari URL (Pretty URLs)
  # Contoh: /preview_soal akan menampilkan /preview_soal.html tanpa redirect
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # Jika mengakses /index langsung, arahkan ke root /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# 3. Kompresi Gzip / Deflate (Mempercepat Loading Web & PageSpeed Score)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 4. Browser Caching (Cache-Control & Expires Headers)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Dokumen HTML: 0 detik (selalu periksa versi terbaru)
  ExpiresByType text/html "access plus 0 seconds"

  # Data JSON: 10 menit
  ExpiresByType application/json "access plus 600 seconds"

  # CSS & JS: 1 minggu
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"

  # Gambar: 1 bulan
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# 5. Keamanan & Proteksi File Sensitif
<IfModule mod_headers.c>
  # Mencegah MIME-sniffing
  Header set X-Content-Type-Options "nosniff"
  # Mengaktifkan proteksi XSS bawaan browser
  Header set X-XSS-Protection "1; mode=block"
  # Referrer Policy aman
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Blokir akses ke file tersembunyi (seperti .git, .env)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>
